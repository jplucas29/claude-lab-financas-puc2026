# Copie este arquivo para .env (na mesma pasta) e preencha. O .env nunca vai para o GitHub.
# Senha de app do Gmail: myaccount.google.com/apppasswords (exige verificação em duas etapas).
GMAIL_USUARIO=seu.email@gmail.com
GMAIL_SENHA_DE_APP=xxxx xxxx xxxx xxxx
# Quem recebe o e-mail (separe por vírgula). Só quem pediu para receber!
DESTINATARIOS=seu.email@gmail.com
